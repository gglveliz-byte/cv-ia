# Configuración de Llave para Qwen 3.8 Flash (Alibaba Cloud DashScope Oficial)
QWEN_API_KEY=tu_api_key_aqui
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Alternativas opcionales:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Base de datos PostgreSQL para memoria persistente (Render Postgres)
DATABASE_URL=postgresql://usuario:password@host.render.com/nombre_db
